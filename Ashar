            renderTimingChart() {
                const container = document.getElementById('chartBarsContainer');
                const filterLabel = document.getElementById('graphFilterLabel');
                if (!container || !this.currentUser) return;

                const isAdmin = this.currentUser.role === 'Administrator';
                const targetLogs = isAdmin ? this.logs : this.logs.filter(l => l.userId === this.currentUser.id);

                if (filterLabel) {
                    filterLabel.innerText = isAdmin ? `All Staff (${targetLogs.length})` : `My Records (${targetLogs.length})`;
                }

                const slots = [
                    { label: '07AM', count: 0 },
                    { label: '08AM', count: 0 },
                    { label: '09AM', count: 0 },
                    { label: '10AM', count: 0 },
                    { label: '11AM', count: 0 },
                    { label: '12PM', count: 0 },
                    { label: '04PM', count: 0 }
                ];

                targetLogs.forEach(l => {
                    const timeStr = l.checkIn;
                    if (!timeStr || timeStr === '-') return;
                    
                    if (timeStr.startsWith('07:')) slots[0].count++;
                    else if (timeStr.startsWith('08:')) slots[1].count++;
                    else if (timeStr.startsWith('09:')) slots[2].count++;
                    else if (timeStr.startsWith('10:')) slots[3].count++;
                    else if (timeStr.startsWith('11:')) slots[4].count++;
                    else if (timeStr.startsWith('12:')) slots[5].count++;
                    else if (timeStr.startsWith('04:')) slots[6].count++;
                    else slots[1].count++;
                });

                const maxCount = Math.max(...slots.map(s => s.count), 4);

                container.innerHTML = slots.map(slot => {
                    const heightPct = Math.max(15, Math.round((slot.count / maxCount) * 100));
                    return `
                        <div class="flex flex-col items-center justify-end h-full group">
                            <span class="text-[9px] font-mono font-bold text-cyan-600 dark:text-cyan-400 mb-0.5 opacity-0 group-hover:opacity-100 transition-opacity">${slot.count}</span>
                            <div class="w-full max-w-[28px] rounded-t-lg bg-gradient-to-t from-cyan-500 via-blue-600 to-indigo-500 transition-all duration-500 shadow-md group-hover:brightness-125" style="height: ${heightPct}%;"></div>
                        </div>
                    `;
                }).join('');
            }

            changeCalendarMonth(direction) {
                this.calMonth += direction;
                if (this.calMonth > 11) {
                    this.calMonth = 0;
                    this.calYear++;
                } else if (this.calMonth < 0) {
                    this.calMonth = 11;
                    this.calYear--;
                }
                this.renderLuxuryCalendar();
            }

            renderLuxuryCalendar() {
                const container = document.getElementById('luxuryCalendarDays');
                const titleEl = document.getElementById('calendarMonthTitle');
                if (!container || !this.currentUser) return;

                const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                if (titleEl) titleEl.innerText = `${monthNames[this.calMonth]} ${this.calYear}`;

                const targetUserId = this.currentUser.id;
                const userLogs = this.logs.filter(l => l.userId === targetUserId);
                
                const logMap = {};
                userLogs.forEach(l => {
                    logMap[l.date] = l;
                });

                const firstDayIndex = (new Date(this.calYear, this.calMonth, 1).getDay() + 6) % 7;
                const totalDays = new Date(this.calYear, this.calMonth + 1, 0).getDate();
                const todayStr = new Date().toISOString().split('T')[0];

                let html = '';

                for (let i = 0; i < firstDayIndex; i++) {
                    html += `<div class="h-9 rounded-xl bg-transparent"></div>`;
                }

                for (let day = 1; day <= totalDays; day++) {
                    const mm = String(this.calMonth + 1).padStart(2, '0');
                    const dd = String(day).padStart(2, '0');
                    const dateStr = `${this.calYear}-${mm}-${dd}`;
                    
                    const log = logMap[dateStr];
                    const isToday = dateStr === todayStr;

                    let bgClass = "bg-slate-50 dark:bg-slate-800/50 text-slate-700 dark:text-slate-300 border border-slate-100 dark:border-slate-800";
                    let tooltip = "No record";

                    if (log) {
                        if (log.status === 'Completed' || log.status === 'Checked In') {
                            bgClass = "bg-blue-600 text-white font-bold shadow-md shadow-blue-900/30 ring-2 ring-blue-400/30";
                            tooltip = `Present: In ${log.checkIn}`;
                        }
                    } else {
                        const dObj = new Date(dateStr);
                        const nowObj = new Date();
                        nowObj.setHours(0,0,0,0);

                        if (dObj < nowObj) {
                            const dayOfWeek = dObj.getDay();
                            if (dayOfWeek !== 0) {
                                bgClass = "bg-rose-600/90 text-white font-bold shadow-md shadow-rose-900/30 ring-2 ring-rose-400/30";
                                tooltip = "Off / Absent";
                            } else {
                                bgClass = "bg-slate-200 dark:bg-slate-800 text-slate-400";
                                tooltip = "Sunday (Weekend Off)";
                            }
                        }
                    }

                    if (isToday) {
                        bgClass += " ring-2 ring-amber-400";
                    }

                    html += `
                        <div title="${tooltip}" class="h-9 rounded-xl flex flex-col items-center justify-center text-xs font-mono transition-all cursor-pointer hover:scale-105 ${bgClass}">
                            <span>${day}</span>
                        </div>
                    `;
                }

                container.innerHTML = html;
            }

            renderActivityFeed() {
                const container = document.getElementById('dashActivityContainer');
                const titleEl = document.getElementById('dashActivityTitle');
                if (!container || !this.currentUser) return;

                const isAdmin = this.currentUser.role === 'Administrator';
                if (titleEl) titleEl.innerText = isAdmin ? "Today's Check-in Activity Feed" : "Your Recent Check-in History";

                let relevantLogs = isAdmin 
                    ? this.logs.slice(-5).reverse()
                    : this.logs.filter(l => l.userId === this.currentUser.id).slice(-5).reverse();

                if (relevantLogs.length === 0) {
                    container.innerHTML = `
                        <div class="py-8 text-center text-xs text-slate-400">
                            <i class="fa-solid fa-clock text-2xl mb-2 text-slate-300"></i>
                            <p>No activity recorded yet.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = relevantLogs.map(log => `
                    <div class="py-3 flex items-center justify-between text-xs">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 rounded-full bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 font-bold flex items-center justify-center">
                                ${log.userName.charAt(0)}
                            </div>
                            <div>
                                <div class="font-bold text-slate-800 dark:text-slate-200">${log.userName} (${log.date})</div>
                                <div class="text-[10px] text-slate-400">${log.userShift} Shift • ${log.note || 'Regular Check'}</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="font-mono font-bold text-emerald-600 dark:text-emerald-400">In: ${log.checkIn}</div>
                            <div class="text-[10px] text-slate-400">Out: ${log.checkOut}</div>
                        </div>
                    </div>
                `).join('');
            }

            getTodayActiveLog() {
                if (!this.currentUser) return null;
                const todayStr = new Date().toISOString().split('T')[0];
                return this.logs.find(l => l.userId === this.currentUser.id && l.date === todayStr && l.status === 'Checked In');
            }

            refreshPunchTerminalState() {
                const activeLog = this.getTodayActiveLog();
                const btnIn = document.getElementById('btnPunchIn');
                const btnOut = document.getElementById('btnPunchOut');
                const indicator = document.getElementById('punchStatusIndicator');
                const timerDisplay = document.getElementById('punchTimerDisplay');

                if (!btnIn || !btnOut || !indicator || !timerDisplay) return;

                if (activeLog) {
                    btnIn.disabled = true;
                    btnIn.className = "py-4 px-6 rounded-2xl bg-slate-200 dark:bg-slate-800 text-slate-400 dark:text-slate-600 font-extrabold text-sm cursor-not-allowed transition-all flex items-center justify-center space-x-3";
                    
                    btnOut.disabled = false;
                    btnOut.className = "py-4 px-6 rounded-2xl bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-500 hover:to-pink-500 text-white font-extrabold text-sm shadow-xl shadow-rose-950/20 transition-all flex items-center justify-center space-x-3 group transform hover:-translate-y-0.5 cursor-pointer";

                    indicator.innerHTML = `
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
                        <span class="text-emerald-400">CHECKED IN (${activeLog.checkIn})</span>
                    `;
                    timerDisplay.classList.remove('hidden');
                } else {
                    btnIn.disabled = false;
                    btnIn.className = "py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-extrabold text-sm shadow-xl shadow-emerald-950/20 transition-all flex items-center justify-center space-x-3 group transform hover:-translate-y-0.5 cursor-pointer";

                    btnOut.disabled = true;
                    btnOut.className = "py-4 px-6 rounded-2xl bg-slate-200 dark:bg-slate-800 text-slate-400 dark:text-slate-600 font-extrabold text-sm cursor-not-allowed transition-all flex items-center justify-center space-x-3";

                    indicator.innerHTML = `
                        <span class="w-2.5 h-2.5 rounded-full bg-slate-500"></span>
                        <span>Not Checked In Today</span>
                    `;
                    timerDisplay.classList.add('hidden');
                }
            }

            updatePunchTimer() {
                const activeLog = this.getTodayActiveLog();
                if (!activeLog) return;

                const timerDisplay = document.getElementById('punchTimerDisplay');
                if (timerDisplay) {
                    const checkInTime = new Date(`${activeLog.date} ${activeLog.checkIn}`);
                    const now = new Date();
                    const diffMs = Math.max(0, now - checkInTime);

                    const hrs = Math.floor(diffMs / 3600000);
                    const mins = Math.floor((diffMs % 3600000) / 60000);
                    const secs = Math.floor((diffMs % 60000) / 1000);

                    timerDisplay.innerText = `Elapsed: ${String(hrs).padStart(2, '0')}h ${String(mins).padStart(2, '0')}m ${String(secs).padStart(2, '0')}s`;
                }
            }

            performPunch(type) {
                if (!this.currentUser) return;
                const now = new Date();
                const todayStr = now.toISOString().split('T')[0];
                const timeStr = now.toLocaleTimeString('en-US', { hour12: true, hour: '2-digit', minute: '2-digit' });
                const noteInput = document.getElementById('punchNoteInput');
                const note = noteInput ? noteInput.value.trim() : '';

                if (type === 'in') {
                    const newLog = {
                        id: `LOG-${Date.now()}`,
                        userId: this.currentUser.id,
                        userName: this.currentUser.name,
                        userShift: this.currentUser.shift,
                        date: todayStr,
                        checkIn: timeStr,
                        checkOut: '-',
                        hoursWorked: 'In Progress',
                        status: 'Checked In',
                        note: note || 'Terminal Check In'
                    };
                    this.logs.unshift(newLog);
                    this.showToast(`Checked IN successfully at ${timeStr}`);
                } else {
                    const activeLog = this.getTodayActiveLog();
                    if (activeLog) {
                        activeLog.checkOut = timeStr;
                        activeLog.status = 'Completed';
                        if (note) activeLog.note = note;

                        const start = new Date(`${activeLog.date} ${activeLog.checkIn}`);
                        const end = new Date(`${activeLog.date} ${timeStr}`);
                        const diffHrs = ((end - start) / 3600000).toFixed(1);
                        activeLog.hoursWorked = `${diffHrs} hrs`;

                        this.showToast(`Checked OUT successfully at ${timeStr}`);
                    }
                }

                if (noteInput) noteInput.value = '';
                this.saveData();
                this.updateUserUI();
                this.renderAllViews();
            }

            renderPersonalPunchHistory() {
                const container = document.getElementById('personalPunchHistory');
                if (!container || !this.currentUser) return;

                const userLogs = this.logs.filter(l => l.userId === this.currentUser.id).slice(0, 5);

                if (userLogs.length === 0) {
                    container.innerHTML = `<p class="text-slate-400 text-center py-2">No personal check-in logs recorded yet.</p>`;
                    return;
                }

                container.innerHTML = userLogs.map(l => `
                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-800 flex justify-between items-center">
                        <div>
                            <div class="font-bold text-slate-800 dark:text-white">${l.date}</div>
                            <div class="text-[10px] text-slate-400">In: ${l.checkIn} | Out: ${l.checkOut}</div>
                        </div>
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold ${l.status === 'Checked In' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300'}">
                            ${l.hoursWorked}
                        </span>
                    </div>
                `).join('');
            }

            renderLogsTable() {
                const tbody = document.getElementById('logsTableBody');
                if (!tbody || !this.currentUser) return;

                const isAdmin = this.currentUser.role === 'Administrator';
                const searchInput = document.getElementById('logSearchInput');
                const shiftFilterEl = document.getElementById('logShiftFilter');
                const statusFilterEl = document.getElementById('logStatusFilter');

                const search = searchInput ? searchInput.value.toLowerCase() : '';
                const shiftFilter = shiftFilterEl ? shiftFilterEl.value : 'ALL';
                const statusFilter = statusFilterEl ? statusFilterEl.value : 'ALL';

                let targetLogs = isAdmin ? this.logs : this.logs.filter(l => l.userId === this.currentUser.id);

                let filtered = targetLogs.filter(log => {
                    const matchSearch = !isAdmin || log.userName.toLowerCase().includes(search) || log.date.includes(search);
                    const matchShift = shiftFilter === 'ALL' || log.userShift === shiftFilter;
                    const matchStatus = statusFilter === 'ALL' || log.status === statusFilter;
                    return matchSearch && matchShift && matchStatus;
                });

                if (filtered.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="8" class="p-8 text-center text-slate-400">
                                No attendance records found.
                            </td>
                        </tr>
                    `;
                    return;
                }

                tbody.innerHTML = filtered.map(log => `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                        <td class="p-4 font-mono">${log.date}</td>
                        <td class="p-4">
                            <div class="font-bold text-slate-800 dark:text-white">${log.userName}</div>
                        </td>
                        <td class="p-4">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${log.userShift === 'Morning' ? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300' : 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300'}">
                                ${log.userShift}
                            </span>
                        </td>
                        <td class="p-4 font-mono text-emerald-600 dark:text-emerald-400">${log.checkIn}</td>
                        <td class="p-4 font-mono text-slate-500">${log.checkOut}</td>
                        <td class="p-4 font-semibold">${log.hoursWorked}</td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${log.status === 'Checked In' ? 'bg-emerald-500 text-white animate-pulse' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300'}">
                                ${log.status}
                            </span>
                        </td>
                        <td class="p-4 text-slate-400">${log.note || '-'}</td>
                    </tr>
                `).join('');
            }

            exportLogsToCSV() {
                const isAdmin = this.currentUser?.role === 'Administrator';
                const exportData = isAdmin ? this.logs : this.logs.filter(l => l.userId === this.currentUser.id);

                if (exportData.length === 0) {
                    this.showToast('No logs available to export.', 'error');
                    return;
                }

                let csv = 'Log ID,User Name,Shift,Date,Check In,Check Out,Hours Worked,Status,Note\n';
                exportData.forEach(l => {
                    csv += `"${l.id}","${l.userName}","${l.userShift}","${l.date}","${l.checkIn}","${l.checkOut}","${l.hoursWorked}","${l.status}","${l.note || ''}"\n`;
                });

                const blob = new Blob(["\ufeff" + csv], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Lytics_Attendance_Export_${new Date().toISOString().split('T')[0]}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                this.showToast('CSV Export downloaded successfully!');
            }

            renderUsersTable() {
                const tbody = document.getElementById('usersTableBody');
                if (!tbody) return;

                tbody.innerHTML = this.users.map(u => `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                        <td class="p-4">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 rounded-lg bg-brand-600 text-white font-black flex items-center justify-center">
                                    ${u.name.charAt(0)}
                                </div>
                                <div>
                                    <div class="font-bold text-slate-800 dark:text-white">${u.name}</div>
                                    <div class="text-[10px] text-slate-400">ID: ${u.id}</div>
                                </div>
                            </div>
                        </td>
                        <td class="p-4 font-mono">${u.email}</td>
                        <td class="p-4 font-mono text-slate-400">
                            <span class="bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded">${u.password}</span>
                        </td>
                        <td class="p-4">
                            <span class="px-2.5 py-0.5 rounded text-[10px] font-extrabold ${u.shift === 'Morning' ? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300' : 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300'}">
                                ${u.shift} (${u.shift === 'Morning' ? '8AM-4PM' : '4PM-12AM'})
                            </span>
                        </td>
                        <td class="p-4">
                            <span class="font-bold ${u.role === 'Administrator' ? 'text-brand-600 dark:text-brand-400' : 'text-slate-500'}">
                                ${u.role}
                            </span>
                        </td>
                        <td class="p-4">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${u.status === 'Active' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300'}">
                                ${u.status}
                            </span>
                        </td>
                        <td class="p-4 text-right space-x-2">
                            <button onclick="app.openUserModal('${u.id}')" class="px-2.5 py-1 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 hover:bg-blue-100 font-bold text-[11px]">
                                Edit
                            </button>
                            ${u.id !== 'USR-101' ? `
                                <button onclick="app.confirmDeleteUser('${u.id}')" class="px-2.5 py-1 rounded-lg bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 hover:bg-rose-100 font-bold text-[11px]">
                                    Delete
                                </button>
                            ` : ''}
                        </td>
                    </tr>
                `).join('');
            }

            openUserModal(userId = null) {
                const modal = document.getElementById('userModal');
                const title = document.getElementById('userModalTitle');
                if (!modal || !title) return;
                
                if (userId) {
                    const found = this.users.find(u => u.id === userId);
                    if (found) {
                        title.innerText = "Edit Employee Credentials";
                        document.getElementById('formUserId').value = found.id;
                        document.getElementById('formName').value = found.name;
                        document.getElementById('formEmail').value = found.email;
                        document.getElementById('formPassword').value = found.password;
                        document.getElementById('formShift').value = found.shift;
                        document.getElementById('formRole').value = found.role;
                        document.getElementById('formStatus').value = found.status;
                    }
                } else {
                    title.innerText = "Add New Employee";
                    const form = document.getElementById('userForm');
                    if (form) form.reset();
                    document.getElementById('formUserId').value = '';
                }

                modal.classList.remove('hidden');
            }

            closeUserModal() {
                const modal = document.getElementById('userModal');
                if (modal) modal.classList.add('hidden');
            }

            saveUserForm(e) {
                e.preventDefault();
                const id = document.getElementById('formUserId').value;
                const name = document.getElementById('formName').value.trim();
                const email = document.getElementById('formEmail').value.trim();
                const password = document.getElementById('formPassword').value.trim();
                const shift = document.getElementById('formShift').value;
                const role = document.getElementById('formRole').value;
                const status = document.getElementById('formStatus').value;

                if (id) {
                    const user = this.users.find(u => u.id === id);
                    if (user) {
                        user.name = name;
                        user.email = email;
                        user.password = password;
                        user.shift = shift;
                        user.role = role;
                        user.status = status;
                        this.showToast(`Updated credentials for ${name}`);
                    }
                } else {
                    const newUser = {
                        id: `USR-${Date.now()}`,
                        name,
                        email,
                        password,
                        shift,
                        role,
                        status
                    };
                    this.users.push(newUser);
                    this.showToast(`New employee ${name} created successfully!`);
                }

                this.saveData();
                this.closeUserModal();
                this.renderAllViews();
            }

            confirmDeleteUser(userId) {
                const user = this.users.find(u => u.id === userId);
                if (!user) return;

                const modal = document.getElementById('confirmModal');
                if (!modal) return;

                document.getElementById('confirmTitle').innerText = `Delete ${user.name}?`;
                document.getElementById('confirmMessage').innerText = `This will permanently delete ${user.email} from the portal.`;

                const cancelBtn = document.getElementById('confirmCancelBtn');
                const okBtn = document.getElementById('confirmOkBtn');

                const cleanup = () => {
                    modal.classList.add('hidden');
                };

                cancelBtn.onclick = cleanup;
                okBtn.onclick = () => {
                    this.users = this.users.filter(u => u.id !== userId);
                    this.saveData();
                    this.renderAllViews();
                    cleanup();
                    this.showToast(`Employee account deleted`, 'error');
                };

                modal.classList.remove('hidden');
            }

            resetDemoData() {
                const modal = document.getElementById('confirmModal');
                if (!modal) return;

                document.getElementById('confirmTitle').innerText = "Reset Demo Data?";
                document.getElementById('confirmMessage').innerText = "This will restore default users and clear custom logs.";

                const cancelBtn = document.getElementById('confirmCancelBtn');
                const okBtn = document.getElementById('confirmOkBtn');

                const cleanup = () => {
                    modal.classList.add('hidden');
                };

                cancelBtn.onclick = cleanup;
                okBtn.onclick = () => {
                    localStorage.removeItem('lytics_users');
                    localStorage.removeItem('lytics_logs');
                    localStorage.removeItem('lytics_current_user');
                    this.users = DEFAULT_USERS;
                    this.logs = DEFAULT_LOGS;
                    this.currentUser = DEFAULT_USERS[0];
                    this.saveData();
                    this.updateUserUI();
                    this.renderAllViews();
                    cleanup();
                    this.showToast('Portal reset to default state!');
                };

                modal.classList.remove('hidden');
            }
        }

        window.app = new LyticsPortal();
    </script>
</body>
</html>
