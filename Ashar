<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LYTICS - Attendance & User Management Portal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace']
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                            950: '#172554'
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
        }
    </style>
</head>
<body class="bg-slate-100 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-200 selection:bg-brand-500 selection:text-white">

    <!-- TOAST NOTIFICATION CONTAINER -->
    <div id="toastContainer" class="fixed top-5 right-5 z-50 flex flex-col space-y-3 pointer-events-none max-w-sm w-full"></div>

    <!-- TOP NAVIGATION HEADER -->
    <header class="bg-brand-900 dark:bg-slate-900 text-white border-b border-brand-800 dark:border-slate-800 sticky top-0 z-30 shadow-lg transition-colors">
        <div class="px-4 sm:px-6 py-3 flex items-center justify-between">
            
            <!-- BRANDING & LOGO -->
            <div class="flex items-center space-x-3 cursor-pointer select-none" onclick="app.navigate('dashboard')">
                <div class="flex items-center space-x-2">
                    <svg class="h-10 sm:h-11 w-auto drop-shadow-md overflow-visible" viewBox="-10 -35 130 155" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="25" y="15" width="80" height="28" rx="14" transform="rotate(-30 25 15)" fill="url(#purple_grad)" />
                        <rect x="15" y="50" width="80" height="28" rx="14" transform="rotate(-30 15 50)" fill="url(#blue_grad)" />
                        <rect x="5" y="85" width="80" height="28" rx="14" transform="rotate(-30 5 85)" fill="url(#teal_grad)" />
                        <defs>
                            <linearGradient id="purple_grad" x1="25" y1="15" x2="105" y2="43" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#a855f7" />
                                <stop offset="1" stop-color="#7c3aed" />
                            </linearGradient>
                            <linearGradient id="blue_grad" x1="15" y1="50" x2="95" y2="78" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#3b82f6" />
                                <stop offset="1" stop-color="#1d4ed8" />
                            </linearGradient>
                            <linearGradient id="teal_grad" x1="5" y1="85" x2="85" y2="113" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#06b6d4" />
                                <stop offset="1" stop-color="#0d9488" />
                            </linearGradient>
                        </defs>
                    </svg>
                    <div class="flex flex-col">
                        <span class="text-2xl font-black tracking-tight text-white font-sans lowercase leading-none">lytics</span>
                        <span class="text-[10px] font-semibold text-brand-200 tracking-wider uppercase mt-1">lytics-portal.com</span>
                    </div>
                </div>
            </div>

            <!-- RIGHT CONTROLS: LIVE CLOCK & USER PROFILE MENU -->
            <div class="flex items-center space-x-3 sm:space-x-5">
                
                <div class="hidden md:flex flex-col text-right pr-4 border-r border-brand-800 dark:border-slate-800">
                    <span id="headerLiveTime" class="text-sm font-bold tracking-wider font-mono text-brand-100">00:00:00 AM</span>
                    <span id="headerLiveDate" class="text-[11px] text-brand-200 font-medium">Loading date...</span>
                </div>

                <!-- USER PROFILE DROPDOWN -->
                <div class="relative">
                    <button onclick="app.toggleUserMenu()" class="flex items-center space-x-3 bg-brand-950/60 dark:bg-slate-800/80 hover:bg-brand-950 dark:hover:bg-slate-800 px-3 py-1.5 rounded-xl border border-brand-700/50 dark:border-slate-700 transition-all focus:outline-none">
                        <div id="userAvatar" class="w-8 h-8 rounded-lg bg-gradient-to-tr from-amber-500 to-indigo-600 text-white flex items-center justify-center font-black text-sm shadow">
                            A
                        </div>
                        <div class="text-left hidden sm:block">
                            <div id="headerUserName" class="text-xs font-bold text-white leading-tight">Ashar</div>
                            <div id="headerUserRole" class="text-[10px] text-brand-200 dark:text-slate-400 font-medium leading-tight">Administrator</div>
                        </div>
                        <i class="fa-solid fa-chevron-down text-brand-300 dark:text-slate-400 text-xs ml-1"></i>
                    </button>

                    <!-- DROPDOWN MENU -->
                    <div id="userDropdown" class="hidden absolute right-0 mt-2 w-64 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 py-2 z-50 text-slate-700 dark:text-slate-200 transform transition-all">
                        <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800">
                            <p class="text-[11px] text-slate-400 font-medium">Logged in via lytics-portal.com</p>
                            <p id="dropdownUserEmail" class="text-xs font-bold text-slate-800 dark:text-white truncate">ashar@lytics-portal.com</p>
                            <div id="dropdownShiftBadge" class="mt-1 inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300">
                                Morning Shift
                            </div>
                        </div>

                        <div class="px-4 py-2.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/50 cursor-pointer text-xs" onclick="app.toggleDarkMode()">
                            <span class="flex items-center space-x-2 font-medium">
                                <i class="fa-solid fa-moon text-indigo-500 dark:text-amber-400 w-4 text-center"></i>
                                <span>Dark Appearance</span>
                            </span>
                            <div id="darkModeSwitch" class="w-8 h-4 bg-slate-300 dark:bg-brand-600 rounded-full relative transition-colors">
                                <div id="darkModeDot" class="w-3 h-3 bg-white rounded-full absolute top-0.5 left-0.5 transition-transform dark:translate-x-4"></div>
                            </div>
                        </div>

                        <div class="border-t border-slate-100 dark:border-slate-800 my-1"></div>

                        <button onclick="app.openLoginOverlay()" class="w-full text-left px-4 py-2 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 flex items-center space-x-2">
                            <i class="fa-solid fa-users-between-lines text-blue-500 w-4 text-center"></i>
                            <span>Switch Account / Sign In</span>
                        </button>

                        <button onclick="app.logout()" class="w-full text-left px-4 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 flex items-center space-x-2">
                            <i class="fa-solid fa-right-from-bracket w-4 text-center"></i>
                            <span>Sign Out</span>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </header>

    <!-- MAIN WORKSPACE LAYOUT -->
    <div class="flex-1 flex overflow-hidden">

        <!-- SIDEBAR NAVIGATION -->
        <aside class="w-64 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col z-20 shrink-0 transition-colors hidden md:flex">
            <div class="p-4 flex-1 space-y-6">
                
                <!-- PORTAL MENU -->
                <div>
                    <div class="px-3 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Portal Navigation</div>
                    <nav class="space-y-1">
                        <button onclick="app.navigate('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-xs font-bold transition-all text-brand-700 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/50">
                            <i class="fa-solid fa-chart-pie w-5 text-center text-sm"></i>
                            <span>Dashboard</span>
                        </button>

                        <button onclick="app.navigate('punch')" id="nav-punch" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all">
                            <i class="fa-solid fa-fingerprint w-5 text-center text-sm text-emerald-500"></i>
                            <span>Check-in Terminal</span>
                        </button>

                        <button onclick="app.navigate('logs')" id="nav-logs" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all">
                            <i class="fa-solid fa-clock-rotate-left w-5 text-center text-sm text-indigo-500"></i>
                            <span id="navLogsLabel">Attendance Logs</span>
                        </button>
                    </nav>
                </div>

                <!-- ADMIN ONLY SECTION -->
                <div id="adminNavSection">
                    <div class="px-3 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Administration</div>
                    <nav class="space-y-1">
                        <button onclick="app.navigate('users')" id="nav-users" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all">
                            <i class="fa-solid fa-users-gear w-5 text-center text-sm text-brand-600"></i>
                            <span>User Management</span>
                        </button>
                    </nav>
                </div>

                <!-- SHIFT SCHEDULE CARD -->
                <div class="p-3.5 bg-slate-50 dark:bg-slate-800/60 rounded-2xl border border-slate-200/80 dark:border-slate-800 text-xs space-y-2">
                    <div class="flex items-center justify-between font-bold text-slate-800 dark:text-slate-200">
                        <span class="flex items-center gap-1.5">
                            <i class="fa-solid fa-business-time text-brand-500"></i>
                            <span>Shift Schedule</span>
                        </span>
                        <span id="shiftCardAdminHint" class="text-[9px] text-brand-600 dark:text-brand-400 font-semibold">Click to Filter</span>
                    </div>
                    <div class="space-y-1.5 text-[11px]">
                        <div id="sidebarMorningCard" onclick="app.filterByShiftCard('Morning')" class="p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex justify-between items-center transition-all cursor-pointer hover:border-brand-300">
                            <div>
                                <div class="font-bold text-slate-700 dark:text-slate-300">Morning Shift</div>
                                <div class="text-[10px] text-slate-400">08:00 AM - 04:00 PM</div>
                            </div>
                            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                        </div>
                        <div id="sidebarEveningCard" onclick="app.filterByShiftCard('Evening')" class="p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex justify-between items-center transition-all cursor-pointer hover:border-brand-300">
                            <div>
                                <div class="font-bold text-slate-700 dark:text-slate-300">Evening Shift</div>
                                <div class="text-[10px] text-slate-400">04:00 PM - 12:00 AM</div>
                            </div>
                            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="p-3 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50">
                <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                    <span class="flex items-center space-x-1.5 font-medium">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>lytics-portal.com</span>
                    </span>
                    <button onclick="app.resetDemoData()" title="Reset demo data" class="hover:text-rose-600 transition-colors text-[11px] font-semibold">
                        <i class="fa-solid fa-arrows-rotate mr-1"></i>Reset
                    </button>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT CONTAINER -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6">

            <!-- MOBILE NAV -->
            <div class="md:hidden flex bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 -mx-4 -mt-4 mb-4 p-2 justify-around">
                <button onclick="app.navigate('dashboard')" class="text-xs font-bold p-2 text-brand-600 flex flex-col items-center">
                    <i class="fa-solid fa-chart-pie text-base"></i>
                    <span class="text-[10px]">Dashboard</span>
                </button>
                <button onclick="app.navigate('punch')" class="text-xs font-bold p-2 text-slate-600 dark:text-slate-300 flex flex-col items-center">
                    <i class="fa-solid fa-fingerprint text-base text-emerald-500"></i>
                    <span class="text-[10px]">Check-in</span>
                </button>
                <button onclick="app.navigate('logs')" class="text-xs font-bold p-2 text-slate-600 dark:text-slate-300 flex flex-col items-center">
                    <i class="fa-solid fa-clock-rotate-left text-base text-indigo-500"></i>
                    <span class="text-[10px]">Logs</span>
                </button>
                <button onclick="app.navigate('users')" id="mobileNavUsers" class="text-xs font-bold p-2 text-slate-600 dark:text-slate-300 flex flex-col items-center">
                    <i class="fa-solid fa-users-gear text-base text-brand-500"></i>
                    <span class="text-[10px]">Users</span>
                </button>
            </div>

            <!-- TAB 1: DASHBOARD OVERVIEW -->
            <section id="tab-dashboard" class="tab-view space-y-6">
                
                <!-- WELCOME BANNER -->
                <div class="relative overflow-hidden bg-gradient-to-r from-brand-900 via-brand-800 to-indigo-900 text-white rounded-3xl p-6 sm:p-8 shadow-xl">
                    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div>
                            <div class="inline-flex items-center space-x-2 px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-xs font-semibold text-brand-200 mb-3">
                                <i id="dashRoleIcon" class="fa-solid fa-shield-halved text-amber-400"></i>
                                <span id="dashRoleTag">Administrator Workspace</span>
                            </div>
                            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
                                Welcome, <span id="dashWelcomeName" class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-amber-100">Ashar</span>!
                            </h1>
                            <p id="dashBannerText" class="text-xs sm:text-sm text-brand-100/80 max-w-xl mt-1">
                                Monitor staff attendance, manage shift allocations, and oversee check-in operations on lytics-portal.com.
                            </p>
                        </div>
                        <div class="flex items-center gap-3">
                            <button onclick="app.navigate('punch')" class="px-5 py-3 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs shadow-lg shadow-emerald-950/40 transition-all flex items-center space-x-2 transform hover:-translate-y-0.5">
                                <i class="fa-solid fa-fingerprint text-base"></i>
                                <span>Go to Check-in Terminal</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- METRICS GRID -->
                <div id="metricsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Dynamic rendering for Admin vs Employee -->
                </div>

                <!-- ANALYTICS & CALENDAR DUAL GRID -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    
                    <!-- LEFT SIDE: COMPACT TIMING GRAPH (5 COLS) -->
                    <div class="lg:col-span-5 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-xl space-y-6 transition-colors flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between">
                                <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-full bg-brand-50 dark:bg-brand-950/80 border border-brand-200 dark:border-brand-800 text-brand-600 dark:text-brand-300 text-[10px] font-bold uppercase tracking-wider">
                                    <i class="fa-solid fa-chart-column"></i>
                                    <span>Arrival Trend</span>
                                </div>
                                <span id="graphFilterLabel" class="text-[10px] font-semibold text-slate-400">All Records</span>
                            </div>
                            <h3 class="text-base font-extrabold text-slate-900 dark:text-white mt-3">Check-in Punctuality</h3>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">Arrival frequency across active slots</p>
                        </div>

                        <!-- COMPACT BAR GRAPH CONTAINER -->
                        <div class="pt-2 pb-1">
                            <div id="chartBarsContainer" class="grid grid-cols-7 gap-1.5 sm:gap-2 items-end h-40 pt-6 pb-2 border-b border-slate-100 dark:border-slate-800">
                                <!-- Rendered dynamically -->
                            </div>
                            <div class="grid grid-cols-7 gap-1.5 sm:gap-2 pt-2 text-center text-[9px] font-mono font-bold text-slate-400">
                                <div>07AM</div>
                                <div>08AM</div>
                                <div>09AM</div>
                                <div>10AM</div>
                                <div>11AM</div>
                                <div>12PM</div>
                                <div>04PM</div>
                            </div>
                        </div>

                        <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-500">
                            <span>Peak Arrival Window</span>
                            <span class="font-bold text-brand-600 dark:text-brand-400">08:00 AM - 09:00 AM</span>
                        </div>
                    </div>

                    <!-- RIGHT SIDE: LUXURY MONTHLY ATTENDANCE CALENDAR (7 COLS) -->
                    <div class="lg:col-span-7 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-xl space-y-4 transition-colors flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between">
                                <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-300 text-[10px] font-bold uppercase tracking-wider">
                                    <i class="fa-solid fa-calendar-days"></i>
                                    <span>Monthly Status Calendar</span>
                                </div>
                                <div class="flex items-center space-x-1.5">
                                    <button onclick="app.changeCalendarMonth(-1)" class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 flex items-center justify-center text-xs text-slate-600 dark:text-slate-300 transition-colors">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </button>
                                    <span id="calendarMonthTitle" class="text-xs font-extrabold text-slate-800 dark:text-white px-2">Month Year</span>
                                    <button onclick="app.changeCalendarMonth(1)" class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 flex items-center justify-center text-xs text-slate-600 dark:text-slate-300 transition-colors">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- CALENDAR GRID -->
                        <div class="space-y-2">
                            <!-- Weekdays Header -->
                            <div class="grid grid-cols-7 text-center text-[10px] font-bold text-slate-400 uppercase">
                                <div>Mon</div>
                                <div>Tue</div>
                                <div>Wed</div>
                                <div>Thu</div>
                                <div>Fri</div>
                                <div>Sat</div>
                                <div>Sun</div>
                            </div>
                            <!-- Days Grid -->
                            <div id="luxuryCalendarDays" class="grid grid-cols-7 gap-1.5 text-xs">
                                <!-- Populated dynamically -->
                            </div>
                        </div>

                        <!-- COLOR LEGEND -->
                        <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 gap-2">
                            <div class="flex items-center space-x-1.5">
                                <span class="w-3 h-3 rounded-full bg-blue-600 shadow-sm"></span>
                                <span class="font-medium">Present / Checked In (Blue)</span>
                            </div>
                            <div class="flex items-center space-x-1.5">
                                <span class="w-3 h-3 rounded-full bg-rose-600 shadow-sm"></span>
                                <span class="font-medium">Off / Absent (Red)</span>
                            </div>
                            <div class="flex items-center space-x-1.5">
                                <span class="w-3 h-3 rounded-full bg-slate-200 dark:bg-slate-800"></span>
                                <span class="font-medium">Upcoming / Unlogged</span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- RECENT ACTIVITY FEED -->
                <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 id="dashActivityTitle" class="text-base font-bold text-slate-800 dark:text-white">Recent Attendance Activity</h3>
                            <p id="dashActivitySub" class="text-xs text-slate-400">Live timeline of check-in events</p>
                        </div>
                        <button onclick="app.navigate('logs')" class="text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline">
                            View All Logs <i class="fa-solid fa-arrow-right ml-1"></i>
                        </button>
                    </div>

                    <div id="dashActivityContainer" class="divide-y divide-slate-100 dark:divide-slate-800">
                        <!-- Rendered dynamically -->
                    </div>
                </div>

            </section>

            <!-- TAB 2: CHECK-IN / CHECK-OUT TERMINAL -->
            <section id="tab-punch" class="tab-view hidden space-y-6">
                
                <div class="max-w-2xl mx-auto bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-10 border border-slate-200/80 dark:border-slate-800 shadow-xl space-y-8">
                    
                    <div class="text-center space-y-2">
                        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-bold">
                            <i class="fa-solid fa-user text-brand-500"></i>
                            <span id="punchUserHeading">Ashar (Administrator)</span>
                        </div>
