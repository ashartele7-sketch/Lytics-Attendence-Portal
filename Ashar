    <!-- JAVASCRIPT APP LOGIC -->
    <script>
        const DEFAULT_USERS = [
            { id: "USR-101", name: "Ashar", email: "ashar@lytics-portal.com", password: "admin123", role: "Administrator", shift: "Morning", status: "Active" },
            { id: "USR-102", name: "Ali Ahmed", email: "ali@lytics-portal.com", password: "emp123", role: "Employee", shift: "Morning", status: "Active" },
            { id: "USR-103", name: "Sara Khan", email: "sara@lytics-portal.com", password: "emp123", role: "Employee", shift: "Evening", status: "Active" },
            { id: "USR-104", name: "Hassan Raza", email: "hassan@lytics-portal.com", password: "emp123", role: "Employee", shift: "Morning", status: "Active" }
        ];

        const DEFAULT_LOGS = [
            {
                id: "LOG-501",
                userId: "USR-102",
                userName: "Ali Ahmed",
                userShift: "Morning",
                date: new Date().toISOString().split('T')[0],
                checkIn: "08:00 AM",
                checkOut: "04:02 PM",
                hoursWorked: "8h 02m",
                status: "Completed",
                note: "Office Desk"
            },
            {
                id: "LOG-502",
                userId: "USR-103",
                userName: "Sara Khan",
                userShift: "Evening",
                date: new Date().toISOString().split('T')[0],
                checkIn: "09:00 AM",
                checkOut: "-",
                hoursWorked: "In Progress",
                status: "Checked In",
                note: "Evening Shift Desk"
            }
        ];

        class LyticsPortal {
            constructor() {
                try {
                    const savedUsers = localStorage.getItem('lytics_users');
                    this.users = savedUsers ? JSON.parse(savedUsers) : DEFAULT_USERS;
                } catch (e) {
                    this.users = DEFAULT_USERS;
                }

                // Ensure ashar@lytics-portal.com always exists with admin rights
                const adminExists = this.users.find(u => u.email.toLowerCase() === 'ashar@lytics-portal.com');
                if (!adminExists) {
                    this.users.unshift({ id: "USR-101", name: "Ashar", email: "ashar@lytics-portal.com", password: "admin123", role: "Administrator", shift: "Morning", status: "Active" });
                }

                try {
                    const savedLogs = localStorage.getItem('lytics_logs');
                    this.logs = savedLogs ? JSON.parse(savedLogs) : DEFAULT_LOGS;
                } catch (e) {
                    this.logs = DEFAULT_LOGS;
                }

                try {
                    const savedUser = localStorage.getItem('lytics_current_user');
                    this.currentUser = savedUser ? JSON.parse(savedUser) : null;
                } catch (e) {
                    this.currentUser = null;
                }

                this.theme = localStorage.getItem('lytics_theme') || 'light';
                this.currentTab = 'dashboard';
                
                const now = new Date();
                this.calYear = now.getFullYear();
                this.calMonth = now.getMonth();

                this.init();
            }

            init() {
                this.applyTheme();
                this.startClock();
                
                if (this.currentUser) {
                    const freshUser = this.users.find(u => u.id === this.currentUser.id || u.email.toLowerCase() === this.currentUser.email.toLowerCase());
                    if (freshUser) {
                        this.currentUser = freshUser;
                        this.hideLoginOverlay();
                        this.updateUserUI();
                        this.renderAllViews();
                    } else {
                        this.openLoginOverlay();
                    }
                } else {
                    this.openLoginOverlay();
                }

                window.addEventListener('click', (e) => {
                    if (!e.target.closest('#userDropdown') && !e.target.closest('button[onclick="app.toggleUserMenu()"]')) {
                        const dd = document.getElementById('userDropdown');
                        if (dd) dd.classList.add('hidden');
                    }
                });
            }

            saveData() {
                try {
                    localStorage.setItem('lytics_users', JSON.stringify(this.users));
                    localStorage.setItem('lytics_logs', JSON.stringify(this.logs));
                    localStorage.setItem('lytics_current_user', JSON.stringify(this.currentUser));
                    localStorage.setItem('lytics_theme', this.theme);
                } catch (e) {
                    console.error("Storage error", e);
                }
            }

            showToast(message, type = 'success') {
                const container = document.getElementById('toastContainer');
                if (!container) return;

                const toast = document.createElement('div');
                toast.className = `pointer-events-auto flex items-center justify-between p-4 rounded-2xl shadow-xl text-xs font-bold text-white transition-all transform translate-y-2 opacity-0 ${
                    type === 'success' ? 'bg-emerald-600' : type === 'error' ? 'bg-rose-600' : 'bg-brand-600'
                }`;
                
                const icon = type === 'success' ? 'fa-circle-check' : type === 'error' ? 'fa-circle-xmark' : 'fa-circle-info';
                
                toast.innerHTML = `
                    <div class="flex items-center space-x-2">
                        <i class="fa-solid ${icon} text-base"></i>
                        <span>${message}</span>
                    </div>
                `;

                container.appendChild(toast);
                setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
                setTimeout(() => {
                    toast.classList.add('opacity-0', '-translate-y-2');
                    setTimeout(() => toast.remove(), 300);
                }, 3500);
            }

            applyTheme() {
                if (this.theme === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.remove('light');
                } else {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.classList.add('light');
                }
