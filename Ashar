                if (tabName === 'users' && this.currentUser?.role !== 'Administrator') {
                    this.showToast('Access restricted to Administrators only.', 'error');
                    return;
                }

                this.currentTab = tabName;
                document.querySelectorAll('.tab-view').forEach(el => el.classList.add('hidden'));
                const activeTab = document.getElementById(`tab-${tabName}`);
                if (activeTab) activeTab.classList.remove('hidden');

                document.querySelectorAll('.nav-btn').forEach(btn => {
                    btn.classList.remove('text-brand-700', 'dark:text-brand-400', 'bg-brand-50', 'dark:bg-brand-950/50', 'font-bold');
                    btn.classList.add('text-slate-600', 'dark:text-slate-400', 'font-semibold');
