            toggleDarkMode() {
                this.theme = this.theme === 'dark' ? 'light' : 'dark';
                this.saveData();
                this.applyTheme();
                this.showToast(`Switched to ${this.theme} mode`, 'info');
            }

            startClock() {
                const update = () => {
                    const now = new Date();
                    const timeStr = now.toLocaleTimeString('en-US', { hour12: true, hour: '2-digit', minute: '2-digit', second: '2-digit' });
                    const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

                    const headerTime = document.getElementById('headerLiveTime');
                    const headerDate = document.getElementById('headerLiveDate');
                    const bigClock = document.getElementById('punchBigClock');
                    const bigDate = document.getElementById('punchBigDate');

                    if (headerTime) headerTime.innerText = timeStr;
                    if (headerDate) headerDate.innerText = dateStr;
                    if (bigClock) bigClock.innerText = timeStr;
                    if (bigDate) bigDate.innerText = dateStr;

                    this.updatePunchTimer();
                };
                update();
                setInterval(update, 1000);
            }

            handleLogin(e) {
                e.preventDefault();
                const emailInput = document.getElementById('loginEmail');
                const passInput = document.getElementById('loginPassword');
                if (!emailInput || !passInput) return;

                const email = emailInput.value.trim().toLowerCase();
                const pass = passInput.value.trim();

                const found = this.users.find(u => u.email.toLowerCase() === email && u.password === pass);

                if (found) {
                    if (found.status === 'Inactive') {
                        this.showToast('Account is currently inactive. Contact Administrator.', 'error');
                        return;
                    }
                    this.currentUser = found;
                    this.saveData();
                    this.hideLoginOverlay();
                    this.updateUserUI();
                    this.navigate('dashboard');
                    this.renderAllViews();
                    this.showToast(`Welcome back, ${found.name}!`);
                } else {
                    this.showToast('Invalid email or password! Try ashar@lytics-portal.com / admin123', 'error');
                }
            }

            openLoginOverlay() {
                const overlay = document.getElementById('loginOverlay');
                const dropdown = document.getElementById('userDropdown');
                if (overlay) overlay.classList.remove('hidden');
                if (dropdown) dropdown.classList.add('hidden');
            }

            hideLoginOverlay() {
                const overlay = document.getElementById('loginOverlay');
                if (overlay) overlay.classList.add('hidden');
